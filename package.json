{
  "name": "kuromojin",
  "version": "3.0.2",
  "description": "Japanese morphological analyzer with a Promise API and a cache, compatible with the tokens of kuromoji.js",
  "keywords": [
    "kuromoji",
    "kuromoji.js",
    "promise",
    "japanese",
    "morphological-analyzer",
    "tokenizer",
    "textlint"
  ],
  "homepage": "https://github.com/azu/kuromojin",
  "bugs": {
    "url": "https://github.com/azu/kuromojin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azu/kuromojin.git"
  },
  "license": "MIT AND Apache-2.0",
  "main": "lib/index.js",
  "files": [
    "lib/",
    "src/",
    "dict/"
  ],
  "types": "lib/index.d.ts",
  "browser": {
    "fs": false,
    "path": false,
    "zlib": false
  },
  "directories": {
    "test": "test"
  },
  "scripts": {
    "build": "cross-env NODE_ENV=production tsc -p .",
    "build:dict": "ts-node scripts/build-dict.ts",
    "compare": "node benchmark/compare.js",
    "cp-public": "mkdir -p public/dict && cp node_modules/kuromoji/dict/*.dat.gz dict/kuromojin.dict public/dict/",
    "dev": "npm run cp-public && vite",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,css}\"",
    "netlify": "npm run web:build",
    "prepare": "git config --local core.hooksPath .githooks",
    "prepublish": "npm run --if-present build",
    "preview": "npm run cp-public && vite preview",
    "profile": "node benchmark/profile.js",
    "test": "mocha \"test/**/*.{js,ts}\"",
    "watch": "tsc -p . --watch",
    "web:build": "npm run cp-public && vite build"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.10.6",
    "cross-env": "^7.0.3",
    "kuromoji": "0.1.2",
    "lint-staged": "^15.2.0",
    "mocha": "^10.2.0",
    "prettier": "^3.1.1",
    "ts-node": "^10.9.2",
    "ts-node-test-register": "^10.0.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.11"
  },
  "email": "azuciao@gmail.com",
  "prettier": {
    "singleQuote": false,
    "printWidth": 120,
    "tabWidth": 4,
    "trailingComma": "none"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css}": [
      "prettier --write"
    ]
  }
}
