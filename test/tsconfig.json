{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        // `pnpm test` and `pnpm run build:dict` run the compiled tests, scripts, and source from test-build/
        "rootDir": "..",
        "outDir": "../test-build",
        "declaration": false
    },
    "include": [
        "../src/**/*",
        "../scripts/**/*",
        "./**/*.ts"
    ]
}
